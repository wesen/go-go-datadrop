# ⚠️  INSECURE DEFAULTS — local development only.
#
# Before this stack is reachable by anyone else, change ZITADEL_MASTERKEY,
# POSTGRES_PASSWORD and DATADROP_ROOT_TOKEN, and put it behind TLS.
#
# ⚠️  ZITADEL_FIRSTINSTANCE_* IN docker-compose.yml APPLIES ONLY ON FIRST INIT.
# Changing the domain, the ports, or the machine-user names and restarting does
# NOTHING — the instance already exists. The reset is:
#
#     make compose-nuke      # docker compose down -v, destroys the database
#
# This is the single most expensive thing not to know about this stack.

# ── Hostnames and ports ───────────────────────────────────────────────────────
#
# Two hostnames, one proxy. Port 8080 is spoken for on the machines this runs
# on, so the stack takes 7070 and 17070.
#
# Each published port is IDENTICAL inside and outside the docker network, and
# the proxy carries both hostnames. That is what makes one URL string mean the
# same thing to your browser and to the datadrop container — which an OIDC
# issuer requires (design guide §13.2).
#
# ⚠️  ONE MANUAL STEP. Add to /etc/hosts:
#
#     127.0.0.1 zitadel.test datadrop.test
#
# Why not *.localhost, which browsers resolve for free? Because RFC 6761
# reserves "localhost" AND EVERY SUBDOMAIN OF IT for loopback, and resolvers
# honour it BEFORE consulting /etc/hosts. Inside a container
# "zitadel.test" therefore means that container, and no network alias or
# extra_hosts entry can override it — verified: curl goes straight to ::1 and
# then 127.0.0.1 with the entry sitting in /etc/hosts unread.
#
# ".test" is also reserved (RFC 6761) but carries no resolution rule, so it can
# be pointed anywhere: at 127.0.0.1 for you, and at the proxy inside the
# network. One line of setup buys a name that means the same thing everywhere.
# The proxy's address inside the docker network, and the subnet it sits on.
#
# Fixed, because *.localhost cannot be reached by a network alias: RFC 6761
# reserves localhost and every subdomain of it for loopback, so inside a
# container "zitadel.test" resolves to the container itself and never
# reaches the proxy. The compose file pins the name to this address with
# extra_hosts instead. Change these only if 10.77.0.0/24 collides with
# something.
DATADROP_SUBNET=10.77.0.0/24
PROXY_IP=10.77.0.2

ZITADEL_DOMAIN=zitadel.test
ZITADEL_PORT=17070
ZITADEL_EXTERNALPORT=17070
ZITADEL_BASE=http://zitadel.test:17070

DATADROP_DOMAIN=datadrop.test
DATADROP_PORT=7070
DATADROP_BASE=http://datadrop.test:7070

# ── Security and bootstrap ────────────────────────────────────────────────────
# Must be exactly 32 characters.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters

# The root principal: an operator break-glass, and what the CLI uses against
# this stack. It bypasses every ownership and membership check, and the server
# says so in a startup warning.
DATADROP_ROOT_TOKEN=local-root-token

# ── Pinned images ─────────────────────────────────────────────────────────────
ZITADEL_VERSION=v4.16.0
TRAEFIK_IMAGE=traefik:v3.7.7
POSTGRES_IMAGE=postgres:17.10-alpine
ALPINE_IMAGE=alpine:3.21

TRAEFIK_LOG_LEVEL=INFO

# ── PostgreSQL (Zitadel's event store; datadrop keeps its SQLite file) ────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ZITADEL_DATABASE_POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/zitadel?sslmode=disable
